---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'scp-antoy 的技术笔记与生活随笔' } = Astro.props;
const pageTitle = title === 'scp-antoy 的博客' ? title : `${title} · scp-antoy`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="site-title" href="/">scp-antoy<span>的博客</span></a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/">首页</a>
          <a href="/tags/">标签</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>
    <main class="wrap main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} scp-antoy</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
